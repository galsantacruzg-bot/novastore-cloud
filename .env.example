# SOLO para desarrollo local, no versionar .env.local
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/novastore
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=TU_CONTRASENA_LOCAL
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_POR_CLAVE_FUERTE
CORS_ALLOWED_ORIGINS=http://localhost:4200
AUTH_REQUIRE_EMAIL_VERIFICATION=false
EMAIL_PROVIDER=disabled
# Configuración opcional para verificación real por HTTPS:
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# MAIL_FROM=NovaStore <verificacion@tu-dominio-verificado.com>
